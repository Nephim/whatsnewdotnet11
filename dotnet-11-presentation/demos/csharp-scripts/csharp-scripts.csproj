<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!--
    In .NET 10 & 11, run any script directly:
      dotnet run 01_Unions_Basics.cs -p:LangVersion=preview
      dotnet run 02_Unions_Results.cs -p:LangVersion=preview
      dotnet run 03_Field_Keyword.cs -p:LangVersion=preview
      dotnet run 04_Collection_Expressions.cs -p:LangVersion=preview
      dotnet run 05_Linq_Aggregations.cs -p:LangVersion=preview
      dotnet run 06_Linq_LeftJoin.cs -p:LangVersion=preview
  -->
  <ItemGroup>
    <Compile Include="01_Unions_Basics.cs" Condition="'$(Script)' == '' Or '$(Script)' == '01'" />
    <Compile Include="02_Unions_Results.cs" Condition="'$(Script)' == '02'" />
    <Compile Include="03_Field_Keyword.cs" Condition="'$(Script)' == '03'" />
    <Compile Include="04_Collection_Expressions.cs" Condition="'$(Script)' == '04'" />
    <Compile Include="05_Linq_Aggregations.cs" Condition="'$(Script)' == '05'" />
    <Compile Include="06_Linq_LeftJoin.cs" Condition="'$(Script)' == '06'" />
  </ItemGroup>

</Project>
