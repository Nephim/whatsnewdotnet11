{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OrderProcessing": {
    "BatchSizeLimit": 50,
    "RegionEndpoint": "eu-west-1",
    "NotificationChannels": [
      {
        "ChannelName": "ReactDashboardWebhook",
        "TargetUrl": "https://frontend.internal/api/webhooks/orders",
        "Retries": 3
      },
      {
        "ChannelName": "SlackAlerts",
        "TargetUrl": "https://hooks.slack.com/services/mock",
        "Retries": 2
      }
    ]
  }
}
